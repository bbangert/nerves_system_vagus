# Linux kernel config fragment: hardware-debug device classes.
#
# SHARED FRAGMENT -- edit shared/linux-hwdebug.config, run `make sync`,
# commit. `make check` fails CI on drift, same as the other fragments.
#
# Referenced from BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES by the Qualcomm
# boards only (dragon_q6a, rubik_pi3); the synced copies on the other targets
# are inert. Hardware-debug workers run in containers that bring their own
# userland (OpenOCD, sigrok, bleak, tshark, ...), but a container can only
# reach a probe, dongle or bus the host kernel exposes as a device -- so the
# drivers and device classes live here.
#
# `make olddefconfig` silently drops a symbol whose `depends on` is unmet, so
# every prerequisite is listed explicitly even where the base defconfig
# already sets it (checked against the 7.2 Kconfig).

# CMSIS-DAP v1 / DAPLink / Pico debug probes are HID devices; OpenOCD and
# pyOCD open them through /dev/hidraw*. hiddev is the legacy
# /dev/usb/hiddev* interface some vendor tools still use.
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_USB_HIDDEV=y

# USB serial. GENERIC is the `new_id` escape hatch for converters with
# unknown VID/PIDs; CH341 and PL2303 cover most cheap SBC console cables.
CONFIG_TTY=y
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_SIMPLE=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m

# usbmon: the kernel side of USB capture (tshark/Wireshark in a container).
CONFIG_USB_MON=m

# USB/IP host side: export a bench USB device (J-Link, logic analyser) to a
# remote machine.
CONFIG_NET=y
CONFIG_USB=y
CONFIG_USBIP_CORE=m
CONFIG_USBIP_HOST=m

# USB-CAN dongles (candleLight / gs_usb, LAWICEL slcan over USB serial). Both
# sit inside `if CAN_NETLINK`.
CONFIG_CAN=m
CONFIG_CAN_DEV=m
CONFIG_CAN_NETLINK=y
CONFIG_CAN_GS_USB=m
CONFIG_CAN_SLCAN=m

# Kernel NFS server for targets that boot nfsroot. The rpc.nfsd/mountd/
# exportfs userland comes from nfs-utils in nerves_defconfig.
CONFIG_INET=y
CONFIG_PROC_FS=y
CONFIG_FILE_LOCKING=y
CONFIG_FSNOTIFY=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFSD=m
CONFIG_NFSD_V4=y

# Board as a USB HID device toward a target (scripted keyboard input).
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_F_HID=y

# Thread/Zigbee sniffer dongles.
CONFIG_IEEE802154=m
CONFIG_IEEE802154_SOCKET=m
CONFIG_MAC802154=m

# USB-to-I2C bridges.
CONFIG_I2C=y
CONFIG_I2C_TINY_USB=m
CONFIG_HID_MCP2221=m

# netem: fault-inject a target's network (delay, loss, reordering).
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_NETEM=m

# RNDIS: Android tethering and Linux/Pi gadget targets that only speak it.
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_RNDIS_HOST=m

# GPIO ABI v1: Debian bookworm's libgpiod 1.6 (OpenOCD linuxgpiod, gpioset)
# still uses it.
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
