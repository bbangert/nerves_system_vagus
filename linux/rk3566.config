# Home Assistant Green (RK3566) additions on top of rockchip_linux_defconfig.

# Vendor Mali Bifrost kmod for the G52 (pairs with libmali in app images).
# rkr7.2's rockchip_linux_defconfig no longer enables it. EXPERT is required
# to set the platform name; DEBUG adds logging and checks to every kbase call.
CONFIG_MALI_BIFROST=y
CONFIG_MALI_PLATFORM_NAME="rk"
CONFIG_MALI_BIFROST_EXPERT=y
# CONFIG_MALI_BIFROST_DEBUG is not set

# /proc/rknpu/{version,load}: readable without mounting debugfs.
CONFIG_ROCKCHIP_RKNPU_PROC_FS=y

# Shares vdpu's registers and IOMMU with the vendor MPP driver.
# CONFIG_VIDEO_HANTRO is not set

# 16 MiB default is too small for multi-stream decode buffers.
CONFIG_CMA_SIZE_MBYTES=128

# Battery-backed RTC on i2c1 (the RK809's own RTC has no backup cell).
CONFIG_RTC_DRV_PCF8563=y

# The Green's GbE PHY is an RTL8211F; the defconfig only has Motorcomm.
CONFIG_REALTEK_PHY=y

# With no console, a hang is only ever recovered by the SoC watchdog (heart
# arms it; U-Boot may already have started it).
CONFIG_DW_WATCHDOG=y

# Previous boot's console in RAM at the DTS ramoops region; U-Boot copies
# it to the SD card. Compression off so the panic record is plain text in
# that raw copy, not deflate data.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_DEFLATE_COMPRESS is not set

# LED stage code: power = default-on, user = heartbeat, activity = mmc host
# trigger (built into the MMC core with LEDS_TRIGGERS). Built in so they
# bind before the rootfs is mounted.
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y

# The SPI NOR holds the factory boot loader and must never be exposed or
# written from Linux. The DTS leaves sfc disabled; this removes the drivers.
# CONFIG_SPI_ROCKCHIP_SFC is not set
# CONFIG_MTD_SPI_NOR is not set

# Rockchip vendor storage on eMMC lives at LBA 7168-7679, inside the stock
# loader area (LBA 64-16383). dwmac-rk writes a random MAC there when U-Boot
# passes none, and UPDATE_LOADER can rewrite the idblock at LBA 64.
# CONFIG_ROCKCHIP_VENDOR_STORAGE is not set
# CONFIG_ROCKCHIP_MMC_VENDOR_STORAGE is not set
# CONFIG_ROCKCHIP_VENDOR_STORAGE_UPDATE_LOADER is not set

# The DTS has no fiq-debugger node; keep uart2 a plain 8250 ttyS2.
# CONFIG_FIQ_DEBUGGER is not set

# /dev/mem reaches the unclaimed SFC's MMIO (STRICT_DEVMEM only guards RAM),
# the last Linux path to the SPI NOR.
# CONFIG_DEVMEM is not set
# mmc_test overwrites whatever card it is bound to, the eMMC included.
# CONFIG_MMC_TEST is not set

# No onboard WiFi. A built-in cfg80211 requests regulatory.db before the
# rootfs is mounted and logs a failure every boot. The explicit =m lines are
# needed: the expanded defconfig records them as =y (from WL_ROCKCHIP's
# select) and merge_config keeps explicit values.
# CONFIG_WL_ROCKCHIP is not set
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# The legacy Utgard (Mali-4xx) driver is a second built-in Mali driver that
# loads on a G52 board and has no hardware here; Bifrost is the GPU driver.
# CONFIG_MALI400 is not set

# The Green has no battery. The RK817 fuel gauge and charger drivers bind to
# the RK809's mfd cells without a matching DT node and fail at every boot.
# CONFIG_BATTERY_RK817 is not set
# CONFIG_CHARGER_RK817 is not set
