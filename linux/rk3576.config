# Vendor Mali Bifrost kmod for the G52 (pairs with the libmali userspace).
# rkr7.2's rockchip_linux_defconfig no longer enables Mali, so this fragment
# is the only thing that builds the kmod. EXPERT is required to set the
# platform name. DEBUG defaults off; the explicit guard keeps it that way
# since it adds logging and runtime checks to every kbase call.
CONFIG_MALI_BIFROST=y
CONFIG_MALI_PLATFORM_NAME="rk"
CONFIG_MALI_BIFROST_EXPERT=y
# CONFIG_MALI_BIFROST_DEBUG is not set
