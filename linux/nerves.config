# Nerves additions on top of rockchip_linux_defconfig + rk3576.config
#
# rockchip_linux_defconfig already enables SQUASHFS(+XZ), VFAT, NLS_CODEPAGE_437,
# NLS_ISO8859_1, WATCHDOG, DW_WATCHDOG, STMMAC_ETH (gmac), MTD/MTD_SPI_NOR/
# SPI_ROCKCHIP_SFC (the boot SPI NOR), SND_SOC_ES8323 (drives the board's
# ES8388 codec via its "everest,es8323" fallback compatible), LEDS_GPIO
# (power/user LEDs) and BT_HCIBTUSB.

# The ROCK 4D's GbE PHY is a Realtek RTL8211F behind gmac0. The vendor
# defconfig only carries the Motorcomm PHY driver; without the Realtek
# driver the PHY's RGMII delays never get configured and ethernet is dead.
CONFIG_REALTEK_PHY=y

# TUN/TAP built in: standard Nerves expectation (VPNs, overlay networks).
# No uevent ever fires for /dev/net/tun, so modalias autoload can't load it
# as a module on first open by some userspaces — built-in sidesteps that.
CONFIG_TUN=y

# MGLRU: multi-gen LRU page reclaim (in 6.1 but default-off in this tree).
# Better reclaim decisions under memory pressure; no known downside here.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Reboot 10s after a kernel panic (belt-and-suspenders alongside the
# heart-armed watchdog, which would also fire eventually).
CONFIG_PANIC_TIMEOUT=10

# Nerves devices must never sleep: remove the suspend capability entirely
# rather than trusting nothing ever writes /sys/power/state.
# CONFIG_SUSPEND is not set

# Plug-and-play peripheral support expected of Nerves systems (audited
# against nerves_system_rpi5). All modules: zero cost until the hardware
# is plugged in. CH341 = the ubiquitous cheap USB-UART; usbnet/cdc_ether/
# rndis = USB ethernet dongles and phone tethering; qmi_wwan = USB cellular
# modems; exfat = the out-of-box format of large USB sticks.
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_EXFAT_FS=m

# squashfs rootfs read perf: direct page-cache reads + per-CPU parallel
# decompression (8 cores; replaces FILE_CACHE + DECOMP_SINGLE)
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y

# pstore pmsg: /dev/pmsg0 lets the app write breadcrumbs that survive a
# crash/reboot (ramoops console+dmesg capture is already enabled)
CONFIG_PSTORE_PMSG=y

# FAT short-name codepage for western-European USB sticks
CONFIG_NLS_CODEPAGE_850=y

# LED triggers for the board's power/user LEDs (gpio-leds in the dts):
# kernel-side timer/pattern/heartbeat effects via /sys/class/leds/*/trigger
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# Vendor storage: neither backend has a device on this board (no eMMC; the
# SPI NOR only holds the bootloader). The MTD variant otherwise produces an
# eternal "deferred probe pending" at boot.
# CONFIG_ROCKCHIP_MTD_VENDOR_STORAGE is not set

# The application data partition is f2fs
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y

# GPU: the vendor Mali Bifrost kmod (CONFIG_MALI_BIFROST=y from rk3576.config)
# provides /dev/mali0 for the proprietary libmali userspace (EGL/GLES/GBM).

# vintage_net's RouteManager uses policy routing (per-interface route tables
# + rules). Without these, `ip route add ... table N` fails with
# "RTNETLINK answers: Operation not supported", crashing vintage_net's
# interface subtree seconds after every successful DHCP lease.
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# Generic Nerves niceties present in official systems (cf. nerves_system_bbb)
# but missing from the Android-heritage vendor defconfig.
# (TUN is built in above — do not re-add =m here: within one fragment the
# LAST occurrence wins the merge.)
CONFIG_POSIX_MQUEUE=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_OF_OVERLAY=y
CONFIG_FW_LOADER_USER_HELPER=y
# Watchdog must not be disarmable once Erlang heart opens it
CONFIG_WATCHDOG_NOWAYOUT=y

# USB gadget ethernet (g_ether) — enables usb0 gadget networking if the
# OTG-capable USB 3.0 port's controller runs in peripheral mode
CONFIG_USB_ETH=y

# Framebuffer console on the HDMI output (the vendor defconfig has no FB
# support at all): unlike a sealed panel product, a dev SBC wants a visible
# console on the monitor. fbcon binds the DRM device's fbdev emulation;
# a KMS application (kmscube, a Flutter embedder, ...) simply takes over
# the DRM device when it starts.
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# The onboard WiFi/BT (Quectel FCU760K, AIC8800D80, USB-attached) is driven
# by the out-of-tree aic8800 driver built in package/aic8800 against this
# kernel.
#
# WL_ROCKCHIP=m (defconfig has =y) plus explicit CFG80211/MAC80211=m:
# built-in cfg80211 requests regulatory.db before the rootfs is mounted
# and logs "failed to load regulatory.db" every boot; as a module it is
# pulled in by aic8800_fdrv (depmod dependency) after the rootfs is up
# and the wireless-regdb file is found. The explicit =m lines are
# required — expanding the defconfig records CFG80211/MAC80211 as
# explicit =y (from the old WL_ROCKCHIP=y select), and the fragment
# merge keeps explicit values unless overridden. (mac80211 is unused —
# aic8800_fdrv is a fullmac driver — but the vendor Kconfig selects it,
# so >=m is forced. The rockchip rfkill glue in wl_rockchip never loads
# as a module and isn't needed: the module's power comes from
# always-on dts regulators.)
CONFIG_WL_ROCKCHIP=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
