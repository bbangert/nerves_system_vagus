# Linux kernel config fragment: container runtime support.
#
# SHARED FRAGMENT -- edit shared/linux-containers.config, run `make sync`,
# commit. Every target subdir keeps its own copy so it stays self-contained;
# `make check` fails CI on drift.
#
# Referenced from BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES by the boards that
# ship a container engine: dragon_q6a, rpi3_64 and rubik_pi3. The synced
# copies on the other targets are inert -- their defconfigs don't reference
# the file.
#
# Netfilter: nftables (netavark's backend, and Vagus's own NAT table) is the
# going-forward interface. The legacy iptables block stays until balena-engine
# and the iptables userland are removed.
#
# PRECONDITION for any new consumer: the legacy-iptables chain hangs off
# NETFILTER_XTABLES_LEGACY, which is `depends on !PREEMPT_RT`. A board whose
# defconfig sets CONFIG_PREEMPT_RT=y cannot use this fragment as-is --
# olddefconfig silently drops every IP_NF_* symbol and the failure only
# surfaces at runtime as `--iptables=true` with no kernel support. All
# current consumers use plain CONFIG_PREEMPT.

# balena-engine
# Kernel-version-agnostic mainline Kconfig, identical across the
# nerves-containers rpi boards.
CONFIG_OVERLAY_FS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_NET_SCHED=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_FAMILY_BRIDGE=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
# CONFIG_NF_NAT_IPV4 is deliberately absent: not a real symbol in either
# kernel tree (6.18, 7.2.10); IPv4 NAT folded into CONFIG_NF_NAT in 5.1.
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_DUMMY=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m

# vagus additions: kernel 6.9+ legacy-iptables gates
#
# 6.18 moved all legacy iptables tables behind NETFILTER_XTABLES_LEGACY ->
# IP{,6}_NF_IPTABLES_LEGACY. Without these gates every IP_NF_* symbol is
# silently dropped by olddefconfig and --iptables=true fails at runtime.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MARK=m

# vagus additions
#   - VETH: absent from the upstream fragment; set explicitly rather than
#     rely on transitive module deps.
#   - USER_NS: absent upstream and from the package fixups; --userns-remap
#     cannot exist without it.
#   - SECCOMP/SECCOMP_FILTER: seccomp filtering is unenforceable without them.
#   - CGROUP_BPF: on cgroup v2 the device controller is BPF-based, unlike
#     v1's CGROUP_DEVICE. It depends on BPF_SYSCALL, without which
#     olddefconfig silently drops it.
#   - KEYS: kernel keyring, a common runtime dependency.
CONFIG_VETH=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_KEYS=y

# vagus additions: namespaces, cgroups and IPC
# Previously enabled only by the balena package's kernel fixups, which go
# away with it.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_POSIX_MQUEUE=y

# vagus additions: nftables
# netavark's nftables backend and Vagus's own NAT table. =m because
# NF_CONNTRACK and NF_NAT are =m anyway.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
