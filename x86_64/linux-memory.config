# Linux kernel config fragment: swap/reclaim tuning, shared by all 11 targets.
#
# SHARED FRAGMENT -- edit shared/linux-memory.config, run `make sync`,
# commit. `make check` fails CI on drift, same as the other fragments.
#
# Fragment values override each target's base defconfig in the merge, which
# lets PANIC_TIMEOUT=10 take effect on boards whose defconfig leaves it unset
# (kernel default 0 = panic hangs forever): dragon_q6a, rubik_pi3, x86_64. The
# rpi trees already carry 10, so it's a no-op there.
#
# ZSWAP_DEFAULT_ON stays off on purpose: which swap backend is active is a
# runtime decision (Vagus.Host.Swap picks zram on SD/eMMC boards or a /data
# swapfile + zswap on UFS/NVMe boards at boot), and zswap in front of zram
# would double-compress. The kernel only needs the symbol built in; whoever
# creates the swap device owns the compression layer.
#
# No THP symbols here: only the two 7.1 boards build THP at all (set in
# their own defconfigs) -- the rpi 6.18 trees don't, and turning it on here
# would be an unrequested behaviour change for them.
#
# BLK_DEV_RAM off: Nerves boots squashfs directly, so the 16 default
# ramdisk devices are dead weight.
CONFIG_SWAP=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
# CONFIG_ZSWAP_DEFAULT_ON is not set
CONFIG_CRYPTO_LZ4=y
CONFIG_PANIC_TIMEOUT=10
# CONFIG_BLK_DEV_RAM is not set
