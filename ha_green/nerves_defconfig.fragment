# Lists: scripts/sync-base.sh appends these to base/nerves_defconfig's values.
BR2_ROOTFS_OVERLAY="${NERVES_DEFCONFIG_DIR}/rootfs_overlay"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/linux-bluetooth.config ${NERVES_DEFCONFIG_DIR}/linux-containers.config ${NERVES_DEFCONFIG_DIR}/linux-memory.config"

# Vagus probes /usr/bin/dbus-daemon and /usr/libexec/bluetooth/bluetoothd and
# starts both itself, so there is no init script. The board has no radio, but
# Home Assistant installs apps by default that need the host's system bus
# (Matter Server mounts /run/dbus), and users plug in USB Bluetooth dongles.
# btusb and its Realtek/Intel/Broadcom/MediaTek support are built in by
# linux-bluetooth.config; its UART symbols are inert here. That fragment also
# carries the USB audio class driver (USB DACs).
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
# btmon shows HCI-level traffic and bluetoothctl/btmgmt drive a dongle without
# the app stack, which is how to tell a firmware problem from a stack problem.
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
# bluez-alsa: the `bluealsa` daemon exposes a connected A2DP headset as
# the ALSA PCM `bluealsa:DEV=MAC,PROFILE=a2dp`. SBC only; AAC (fdk-aac) is
# gated on legal review.
BR2_PACKAGE_BLUEZ_ALSA=y

# Dongle firmware, loaded by btusb from /lib/firmware. Realtek is the most
# common dongle family; the rest are the USB-capable sets Buildroot offers.
# Broadcom USB dongles need .hcd files that linux-firmware does not carry and
# Buildroot has no package for, so those only work if the dongle's own ROM is
# enough. Atheros AR3012 is absent: it needs the kernel's separate ath3k loader,
# which the shared Bluetooth fragment does not build.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_IBT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7920_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174A_BT=y

# libnl: vintage_net_wifi's NIF compiles against libnl-genl-3.0, and
# nerves_pack pulls it into every target's firmware. No WiFi hardware here,
# but without the library the firmware does not build.
BR2_PACKAGE_LIBNL=y

# ---- Custom: container engine ----
# podman, driven per operation by Vagus through its CLI. The vagus-* recipes
# are synced from shared/package/ by `make sync`; the kernel side is
# shared/linux-containers.config. cgroup v2 is mounted by erlinit.config.
BR2_PACKAGE_VAGUS_CRUN=y
BR2_PACKAGE_VAGUS_NETAVARK=y
BR2_PACKAGE_VAGUS_PODMAN=y
# Buildroot's 2.1.8. At the size cap it renames a fresh file over the log,
# the same rotation as the 2.2.1 Vagus's log follower was tested against.
BR2_PACKAGE_CONMON=y
# The init process podman runs for --init.
BR2_PACKAGE_CATATONIT=y
# policy.json, and registries.conf with docker.io as the only unqualified
# search registry, as Docker resolved short names.
BR2_PACKAGE_CONTAINERS_IMAGE_CONFIG=y
# netavark's firewall driver, and Vagus programs its own NAT table with nft.
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_NFTABLES_JSON=y
# This BusyBox has no swapon, mkswap, nsenter, mountpoint or pivot_root,
# and Vagus's swapon, mkswap and mount calls were proven against util-linux.
# nsenter is how to look into a container's namespaces from the board's
# shell.
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
BR2_PACKAGE_UTIL_LINUX_PIVOT_ROOT=y
BR2_PACKAGE_UTIL_LINUX_NSENTER=y
