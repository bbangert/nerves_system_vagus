# GENERATED by scripts/sync-base.sh from base/nerves_defconfig + nerves_defconfig.fragment. DO NOT EDIT.
BR2_aarch64=y
BR2_cortex_a55=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/nerves-project/toolchains/releases/download/v15.3.1/nerves_toolchain_aarch64_nerves_linux_gnu-linux_${shell uname -m}-15.3.1-C0D130A.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="aarch64-nerves-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_0=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TAR_OPTIONS="--no-same-owner"
BR2_BACKUP_SITE="https://dl.nerves-project.org"
BR2_ENABLE_DEBUG=y
BR2_GLOBAL_PATCH_DIR="${BR2_EXTERNAL_NERVES_PATH}/patches"
BR2_REPRODUCIBLE=y
BR2_ROOTFS_SKELETON_CUSTOM=y
BR2_ROOTFS_SKELETON_CUSTOM_PATH="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/skeleton"
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_TABLE="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/device_table.txt"
BR2_ENABLE_LOCALE_WHITELIST="locale-archive"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_ROOTFS_OVERLAY="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/rootfs_overlay ${NERVES_DEFCONFIG_DIR}/base/rootfs_overlay ${NERVES_DEFCONFIG_DIR}/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="${NERVES_DEFCONFIG_DIR}/base/post-build.sh ${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="${NERVES_DEFCONFIG_DIR}/base/post-createfs.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# armbian/linux-rockchip branch rk-6.1-rkr7.2 (Rockchip BSP 6.1 + stable
# merges + Armbian fixes; kernel 6.1.172), pinned to the 2026-11-04 tip.
# The board's device tree is added by the patch under linux/.
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/armbian/linux-rockchip/archive/858550966271b1f59897a106bc3f92842ea0e750.tar.gz"
BR2_LINUX_KERNEL_PATCH="${NERVES_DEFCONFIG_DIR}/base/linux"
# rockchip_linux_defconfig + the RK3566 fragment, plus Nerves requirements.
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="rockchip_linux"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/base/linux/rk3566.config ${NERVES_DEFCONFIG_DIR}/base/linux/nerves.config ${NERVES_DEFCONFIG_DIR}/linux-bluetooth.config ${NERVES_DEFCONFIG_DIR}/linux-containers.config ${NERVES_DEFCONFIG_DIR}/linux-memory.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# The .dtb basename must match the devicetree.dtb resource in fwup.conf.
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3566-ha-green"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_CONFIG="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/busybox.config"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/base/busybox.fragment"
BR2_PACKAGE_E2FSPROGS=y
# BR2_PACKAGE_E2FSPROGS_FSCK is not set
# resize2fs for the product's provisioner: fwup's expand = true and the
# SD-only expand-data task grow the partition, not the filesystem in it.
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_DTC=y
BR2_PACKAGE_LIBMNL=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_KMOD_XZ=y
# U-Boot proper only: the board's stock first-stage loader loads the FIT this
# produces. v2026.04 matches the U-Boot HAOS ships on this board.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_TARBALL=y
BR2_TARGET_UBOOT_CUSTOM_TARBALL_LOCATION="https://github.com/u-boot/u-boot/archive/refs/tags/v2026.04.tar.gz"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="green"
BR2_TARGET_UBOOT_PATCH="${NERVES_DEFCONFIG_DIR}/base/uboot/patches"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/base/uboot/green.fragment"
# Without this the compiled-in environment is U-Boot's own and the board
# silently runs `bootflow scan` instead of the boot script (scripts/check-fit.sh
# looks for the script in the binary).
BR2_TARGET_UBOOT_DEFAULT_ENV_FILE="${NERVES_DEFCONFIG_DIR}/base/uboot/uboot.env"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_USE_BINMAN=y
# BR2_TARGET_UBOOT_FORMAT_BIN is not set
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot.itb"
# Committed rkbin blobs (see uboot/rkbin/README.md), not Buildroot's
# rockchip-rkbin package: that pins an older rkbin than the DDR/BL31 pair
# this board was proven with. The DDR blob only lets binman complete; the
# stock loader's own DDR init is what runs.
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="ROCKCHIP_TPL=${NERVES_DEFCONFIG_DIR}/base/uboot/rkbin/rk3566_ddr_1056MHz_v1.18.bin BL31=${NERVES_DEFCONFIG_DIR}/base/uboot/rkbin/rk3568_bl31_v1.43.elf"
# uboot-env.bin from uboot/uboot.env. The size must equal CONFIG_ENV_SIZE in
# uboot/green.fragment: both CRCs cover size - 4 bytes.
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SOURCE="${NERVES_DEFCONFIG_DIR}/base/uboot/uboot.env"
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SIZE="131072"
BR2_NERVES_SYSTEM_NAME="nerves_system_ha_green"
BR2_NERVES_ADDITIONAL_IMAGE_FILES="${NERVES_DEFCONFIG_DIR}/base/fwup.conf"
BR2_PACKAGE_NBTTY=y
BR2_PACKAGE_NERVES_CONFIG=y
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y
# eudev and libinput for USB input devices; no UI toolkit is included.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_LIBINPUT=y
# ALSA userspace for HDMI audio.
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# ---- product layer: nerves_defconfig.fragment ----
# Lists: scripts/sync-base.sh appends these to base/nerves_defconfig's values.

# The board has no radio, so there is no BlueZ, D-Bus or controller firmware.
# linux-bluetooth.config stays in the kernel list for its USB audio class
# driver (USB DACs); its Bluetooth symbols are inert without userspace.

# ---- Custom: container engine ----
# podman, driven per operation by Vagus through its CLI. The vagus-* recipes
# are synced from shared/package/ by `make sync`; the kernel side is
# shared/linux-containers.config. cgroup v2 is mounted by erlinit.config.
BR2_PACKAGE_VAGUS_CRUN=y
BR2_PACKAGE_VAGUS_NETAVARK=y
BR2_PACKAGE_VAGUS_PODMAN=y
# Buildroot's 2.1.8. At the size cap it renames a fresh file over the log,
# the same rotation as the 2.2.1 Vagus's log follower was tested against.
BR2_PACKAGE_CONMON=y
# The init process podman runs for --init.
BR2_PACKAGE_CATATONIT=y
# policy.json, and registries.conf with docker.io as the only unqualified
# search registry, as Docker resolved short names.
BR2_PACKAGE_CONTAINERS_IMAGE_CONFIG=y
# netavark's firewall driver, and Vagus programs its own NAT table with nft.
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_NFTABLES_JSON=y
# This BusyBox has no swapon, mkswap, nsenter, mountpoint or pivot_root,
# and Vagus's swapon, mkswap and mount calls were proven against util-linux.
# nsenter is how to look into a container's namespaces from the board's
# shell.
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
BR2_PACKAGE_UTIL_LINUX_PIVOT_ROOT=y
BR2_PACKAGE_UTIL_LINUX_NSENTER=y
