#!/usr/bin/env python3
# Minimal `xxd -i` (stdin to a C byte list) for U-Boot's default-env rule.
import sys
if sys.argv[1:] != ["-i"]:
    sys.exit("only `xxd -i` on stdin is supported")
data = sys.stdin.buffer.read()
for i in range(0, len(data), 12):
    sys.stdout.write("  " + ", ".join("0x%02x" % b for b in data[i:i + 12]) + ("," if i + 12 < len(data) else "") + "\n")
