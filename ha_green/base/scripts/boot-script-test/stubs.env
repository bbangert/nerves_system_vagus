# Replace these keys of the real uboot/uboot.env in the sandbox's default
# env. Only leaf hooks and hardware addresses are replaced; every script
# variable is the real one. booti and reset
# print what the matrix checks and power the sandbox off.
nerves_go=echo "@@BOOT disk=${nerves_disk} slot=${nerves_slot} state=${nerves_state}"; echo "@@ARGS ${bootargs}"; echo "@@KERNEL"; md.b ${kernel_addr_r} 0x20; echo "@@DTB"; md.b ${fdt_addr_r} 0x20; echo "@@WDT"; md.l ${nerves_wdt_cr} 4; echo "@@LED"; led user; poweroff
nerves_reset=echo "@@RESET disk=${nerves_disk} state=${nerves_state}"; echo "@@LED"; led user; poweroff
nerves_fail_pause=0
nerves_wdt_cr=0x121d0000
nerves_wdt_torr=0x121d0004
nerves_wdt_crr=0x121d000c
