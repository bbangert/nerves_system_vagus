-m configfs:/sys/kernel/config:configfs:nodev,noexec,nosuid:

# Container engine: unified cgroup v2 hierarchy, the only one podman 6
# supports; nothing else mounts a cgroup. erlinit's -m is a generic mount()
# passthrough (src/fs.c), so no erlinit changes are needed. base/ mounts no
# cgroup v1 hierarchy, so every controller is free for cgroup2 without
# cgroup_no_v1 on the kernel cmdline, and the vendor kernel enables the
# memory controller by default. Kernel side: linux-containers.config.
-m cgroup2:/sys/fs/cgroup:cgroup2:nodev,noexec,nosuid:
