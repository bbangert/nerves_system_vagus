# Nerves U-Boot environment for the Radxa ROCK 4D (RK3576)
#
# Compiled into uboot-env.bin and written to the start of GPT p1 on the UFS
# LUN; see fwup_include/fwup-common.conf and rootfs_overlay/etc/fw_env.config.
#
# The SPI NOR U-Boot (CONFIG_ENV_IS_IN_SCSI, p1 found by its unique GUID; see
# uboot/ufs.fragment) loads this environment and runs `bootcmd` below, which
# implements A/B slot selection with automatic revert of unvalidated
# firmware.
#
# NOTE: loading a saved environment REPLACES U-Boot's built-in defaults, so
# the memory-layout variables from include/configs/rk3576_common.h are
# reproduced here, and boot_targets is kept so the `bootflow scan` fallback
# at the end of bootcmd still works.

# A/B boot with automatic revert, then fall back to standard boot (extlinux/
# extlinux.conf on the FAT partition) if the nerves boot path fails. If the
# saved env is ever corrupted, U-Boot ignores it entirely and its compiled-in
# default bootcmd (bootflow scan) boots the extlinux config instead —
# automatic recovery either way. Both depend on bootfs being the only
# partition marked bootable (fwup.conf).
bootcmd=run nerves_init nerves_boot; bootflow scan -lb

# From rk3576_common.h ENV_MEM_LAYOUT_SETTINGS (U-Boot v2027.01-rc1)
scriptaddr=0x40c00000
script_offset_f=0xffe000
script_size_f=0x2000
pxefile_addr_r=0x40e00000
kernel_addr_r=0x42000000
kernel_comp_addr_r=0x4a000000
kernel_comp_size=0x8000000
fdt_addr_r=0x52000000
fdtoverlay_addr_r=0x52100000
ramdisk_addr_r=0x52180000

# For the bootflow scan fallback: the UFS LUN only (the boot ROM already
# guarantees we were loaded from SPI NOR).
boot_targets=scsi

#
# Nerves variables
#

nerves_fw_active=a

# Validation is performed by nerves_runtime's startup guard once all OTP
# applications start (autovalidate=0). If a newly-installed firmware fails
# to reach that point before the next boot, nerves_init reverts to the
# previous slot.
nerves_fw_autovalidate=0

# Set to 1 at factory-flash time (fwup complete) since that firmware is
# implicitly trusted.
nerves_fw_validated=1

# 0 on the first boot after an install; U-Boot sets it to 1 so a second
# boot without validation triggers the revert.
nerves_fw_booted=0

nerves_revert=\
    if test ${nerves_fw_active} = "a"; then\
        echo "Reverting to firmware slot B";\
        setenv nerves_fw_active "b";\
    else\
        echo "Reverting to firmware slot A";\
        setenv nerves_fw_active "a";\
    fi

nerves_init=\
    if test ${nerves_fw_booted} = 1; then\
        if test ${nerves_fw_validated} = 0; then\
            run nerves_revert;\
            setenv nerves_fw_validated 1;\
            saveenv;\
        fi;\
    else\
        setenv nerves_fw_booted 1;\
        if test ${nerves_fw_autovalidate} = 1; then\
            setenv nerves_fw_validated 1;\
        fi;\
        saveenv;\
    fi;\
    setenv bootfile Image.${nerves_fw_active};\
    setenv fdtfile rk3576-rock-4d.${nerves_fw_active}.dtb;\
    if test ${nerves_fw_active} = "a"; then\
        setenv uenv_root PARTUUID=d690c98b-aa26-4de8-afdd-fb4012101478;\
    else\
        setenv uenv_root PARTUUID=fccbcc82-6622-48ed-9d88-9f84cb606e6b;\
    fi

console=ttyFIQ0
cmdline=

nerves_setargs=setenv bootargs console=${console} console=tty1 root=${uenv_root} rootfstype=squashfs rootwait ${cmdline}

# Must equal UBOOT_ENV_PART_GUID (fwup) and CONFIG_ENV_SCSI_PART_UUID
# (uboot/ufs.fragment); scripts/check-env-config.sh enforces it.
nerves_env_uuid=a8319de8-8a9f-4eba-968c-fde1f93ec6b5

# U-Boot found this env by p1's GUID on whichever SCSI device has it, and
# which device number the UFS user LUN gets is unverified, so the kernel
# loads look the disk up the same way instead of assuming scsi 0. `part
# uuid` prints GPT GUIDs lowercase, as fwup writes them.
nerves_find_disk=\
    setenv nerves_disk 0;\
    for d in 0 1 2 3 4 5 6 7; do\
        if part uuid scsi ${d}:1 nerves_p1uuid; then\
            if test "${nerves_p1uuid}" = "${nerves_env_uuid}"; then\
                setenv nerves_disk ${d};\
            fi;\
        fi;\
    done;\
    setenv nerves_p1uuid

# p2 = bootfs. The env lookup already scanned SCSI; scanning again is cheap
# and keeps this script independent of that.
nerves_boot=\
    scsi scan;\
    run nerves_find_disk;\
    load scsi ${nerves_disk}:2 ${kernel_addr_r} ${bootfile};\
    load scsi ${nerves_disk}:2 ${fdt_addr_r} ${fdtfile};\
    run nerves_setargs;\
    booti ${kernel_addr_r} - ${fdt_addr_r}
