# Additional configuration for erlinit
#
# To override the settings in this file, see
# https://hexdocs.pm/nerves/advanced-configuration.html#overriding-erlinit-config-from-mix-config.
#

# Turn on the debug prints
#-v

# Specify where erlinit should send the IEx prompt. Only one may be enabled at
# a time.
# ttyMSM0 is the qcom GENI debug UART expected on the Rubik Pi 3 per the
# mainline dts (serial0 = &uart5), same device the firmware/GRUB serial
# console uses -- still needs live-board verification.
-c ttyMSM0

# If more than one tty are available, always warn if the user is looking at the
# wrong one.
--warn-unused-tty

# Use nbtty to improve terminal handling on serial ports. It's a noop on HDMI.
-s "/usr/bin/nbtty"

# Specify the user and group IDs for the Erlang VM
#--uid 100
#--gid 200

# Uncomment to ensure that the system clock is set to at least the Nerves
# System's build date/time. If you enable this, you'll still need to use NTP or
# another mechanism to set the clock, but it won't be decades off.
#--update-clock

# Uncomment to hang the board rather than rebooting when Erlang exits
# NOTE: Do not enable on production boards
#--hang-on-exit

# Change the graceful shutdown time. If 10 seconds isn't long enough between
# calling "poweroff", "reboot", or "halt" and :init.stop/0 stopping all OTP
# applications, enable this option with a new timeout in milliseconds.
#--graceful-shutdown-timeout 15000

# Optionally run a program if the Erlang VM exits
#--run-on-exit /bin/sh

# Enable UTF-8 filename handling in Erlang and custom inet configuration
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc

# Enable crash dumps (set ERL_CRASH_DUMP_SECONDS=0 to disable)
# The app-data partition mounts at /data (see below), so crash dumps go there
# rather than /root, which resolves onto the read-only rootfs skeleton.
-e ERL_CRASH_DUMP=/data/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Mount the application partition (run "man fstab" for field names)
# NOTE: This must match the location in the fwup.conf. If it doesn't the system
#       will probably still work fine, but you won't get shell history since
#       shoehorn/nerves_runtime can't mount the application filesystem before
#       the history is loaded. If this mount fails due to corruption, etc.,
#       nerves_runtime will auto-format it. Your applications will need to handle
#       initializing any expected files and folders.
#
# The app-data partition mounts at /data (HAOS-shaped naming, rpi3_64
# convention). /dev/rootdisk0p5 is erlinit's alias for partition 5 of
# whatever disk provides the rootfs (NVMe p5 here), so this stays correct
# if the disk enumerates differently.
#
# fwup's NERVES_FW_APPLICATION_PART0_TARGET (fwup_include/fwup-common.conf)
# deliberately says "/root", NOT "/data" -- /data is a symlink to root, so
# the kernel records this mount as /root in /proc/mounts, and nerves_runtime
# needs the fwup value to match that canonical string literally.
-m /dev/rootdisk0p5:/data:ext4:nodev:
-m configfs:/sys/kernel/config:configfs:nodev,noexec,nosuid:

# Container engine: unified cgroup v2 hierarchy, the only one podman 6
# supports; nothing else mounts a cgroup. erlinit's -m is a generic mount()
# passthrough (src/fs.c), so no erlinit changes are needed. Paired with
# `cgroup_no_v1=all cgroup_enable=memory` on the kernel cmdline (grub.cfg,
# BOTH slots) and the CGROUP_* symbols in linux-containers.config.
-m cgroup2:/sys/fs/cgroup:cgroup2:nodev,noexec,nosuid:

# Point the firmware loader at the board's `usb_fw` partition so the
# Renesas USB3 controller (Type-A ports + GbE) can load its firmware once
# xhci-pci-renesas autoloads. See the script for why it isn't in the rootfs.
--pre-run-exec /usr/sbin/rubik-usb-fw

# Erlang release search path
-r /srv/erlang

# Assign a hostname of the form "nerves-<last 4 chars of the serial number>".
# rubik-boardid uses the SoC serial, falling back to /etc/boardid.config.
-d /usr/bin/rubik-boardid
-n nerves-%-.4s

# If using shoehorn (https://github.com/nerves-project/shoehorn), start the
# shoehorn OTP release up first. If shoehorn isn't around, erlinit fails back
# to the main OTP release.
--boot shoehorn
