# Device permissions for the QCS6490 AI foundation (fastrpc, DMA heaps, Venus,
# GPU render nodes).
#
# NOTE: Nerves does not run udev (device nodes come from devtmpfs and the
# Erlang app runs as root), so these rules are INERT on the base system.
# They are shipped as the documented permission contract for environments
# that do evaluate udev rules — e.g. containers bind-mounting /dev, or a
# future unprivileged-user setup — following the same rationale as the Q6A
# port, which modeled these rules on the RadxaOS/Debian precedent.

SUBSYSTEM=="misc", KERNEL=="fastrpc-*", MODE="0666"
SUBSYSTEM=="dma_heap", KERNEL=="system", MODE="0666"
SUBSYSTEM=="video4linux", KERNEL=="video*", MODE="0660", GROUP="video"
SUBSYSTEM=="drm", KERNEL=="renderD*", MODE="0666"
