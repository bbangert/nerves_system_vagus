# Linux kernel config fragment: container runtime support (balena-engine).
#
# SHARED FRAGMENT -- edit shared/linux-containers.config, run `make sync`,
# commit. Every target subdir keeps its own copy so it stays self-contained;
# `make check` fails CI on drift.
#
# Referenced from BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES by the boards that
# ship vagus-balena-engine: rpi3_64 (kernel 6.18), dragon_q6a (7.1.4), and
# rubik_pi3 (7.1). The synced copies on the other targets are inert -- their
# defconfigs don't reference the file.
#
# The "# balena-engine" block below is ported VERBATIM from
# research/balena-packaging-scan.md §2 (the nerves-containers org's
# linux.fragment for rpi3_64/rpi4/rpi3 -- confirmed identical across those
# boards). It is kernel-version-agnostic mainline Kconfig (no board- or
# vendor-specific symbols), so it carries forward unmodified onto both
# kernels here.
#
# PRECONDITION for any new consumer: the legacy-iptables chain below hangs
# off NETFILTER_XTABLES_LEGACY, which is `depends on !PREEMPT_RT`. A board
# whose defconfig sets CONFIG_PREEMPT_RT=y cannot use this fragment as-is --
# olddefconfig will silently drop every IP_NF_* symbol and the failure only
# surfaces at runtime as `--iptables=true` with no kernel support. Both
# current consumers use plain CONFIG_PREEMPT.
#
# Do NOT add CONFIG_NF_TABLES* here (locked decision: iptables-legacy
# userland + legacy kernel symbols for the spike, no nftables).
#
# Note: balena-engine's own Buildroot package carries
# BALENA_ENGINE_LINUX_CONFIG_FIXUPS (KCONFIG_ENABLE_OPT) that force-enables
# NAMESPACES/NET_NS/PID_NS/UTS_NS/IPC_NS/conntrack/IP_NF_FILTER/IP_NF_NAT/
# BRIDGE/VETH/POSIX_MQUEUE/CGROUPS at kernel-config time regardless of this
# fragment (task 1.5 verifies the merged result via check-config.sh). This
# fragment does not need to duplicate those.

# balena-engine
CONFIG_OVERLAY_FS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_NET_SCHED=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_FAMILY_BRIDGE=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
# CONFIG_NF_NAT_IPV4 was dropped from the ported block: it is not a real
# Kconfig symbol in either consumer's tree (grepped against 6.18 and 7.1.4);
# mainline folded IPv4 NAT into CONFIG_NF_NAT in 5.1. A dead line here is
# inert but reads as coverage that doesn't exist.
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_DUMMY=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m

# vagus additions: kernel 6.9+ legacy-iptables gates
#
# Found at Gate A: kernel 6.18 moved all legacy iptables *tables* behind
# NETFILTER_XTABLES_LEGACY -> IP{,6}_NF_IPTABLES_LEGACY. Without these gates
# every IP_NF_* line above/below and the package's KCONFIG_ENABLE_OPT fixups
# (IP_NF_FILTER, IP_NF_NAT) are silently dropped by olddefconfig — the
# daemon's --iptables=true then fails at runtime with no kernel support.
# The ported fragment and balena's fixups predate this Kconfig split.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MARK=m

# vagus additions
#
# Gaps the ported block above does not cover, added per plan task 1.1:
#   - CONFIG_VETH: the upstream nerves-containers fragment omits this
#     entirely (research: balena-packaging-scan.md §2 flags it as a
#     "worth double-checking" latent gap); add explicitly rather than rely
#     on transitive module deps.
#   - CONFIG_USER_NS: also absent upstream AND from the package's own
#     KCONFIG_ENABLE_OPT fixups (research flags this as a real security gap
#     — no --userns-remap possible without it). Not currently used for
#     --userns-remap in this spike, but required kernel-side for the option
#     to exist at all; cheap to enable now.
#   - CONFIG_SECCOMP / CONFIG_SECCOMP_FILTER: required for seccomp
#     filtering to be enforceable at all — this is the kernel-side half of
#     the spike's seccomp exit criterion (unknown #2: `Seccomp: 2` in
#     /proc/<pid>/status). The userland half is the libseccomp build-tag
#     patch to the vagus-owned balena-engine package (task 1.3) +
#     BR2_PACKAGE_LIBSECCOMP=y (defconfig-additions.md). Gate A (task 1.5)
#     verifies CONFIG_SECCOMP_FILTER=y survives in the merged .config.
#   - CONFIG_CGROUP_BPF: needed for runc's device-cgroup-via-eBPF path on
#     cgroup v2 (the "device controller" on unified hierarchy is
#     BPF-program-based, unlike v1's CGROUP_DEVICE). Since this fork runs
#     pure cgroup v2 unified (locked decision, task 1.2/1.6), this is
#     required where the upstream v1-shaped fragment didn't need it.
#   - CONFIG_KEYS: kernel keyring support; not referenced by the
#     upstream fragment or the package's fixups, but common runc/containerd
#     dependency (keyring-based credential/secret handling paths). Included
#     defensively per plan task 1.1's explicit list.
CONFIG_VETH=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# CGROUP_BPF depends on BPF_SYSCALL — without it the merged .config silently
# dropped CGROUP_BPF (found at Gate A verification).
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_KEYS=y
