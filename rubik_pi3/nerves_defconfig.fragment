# Lists: scripts/sync-base.sh appends these to base/nerves_defconfig's values.
BR2_ROOTFS_OVERLAY="${NERVES_DEFCONFIG_DIR}/rootfs_overlay"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/linux-bluetooth.config ${NERVES_DEFCONFIG_DIR}/linux-containers.config ${NERVES_DEFCONFIG_DIR}/linux-memory.config"

# Universal Proxy: BlueZ host stack + D-Bus (userspace). USB BT + USB-audio
# kernel drivers come from linux-bluetooth.config; bluetoothd/dbus-daemon are
# launched by the app. USB BT dongles needing firmware rely on the Realtek
# blob set base/nerves_defconfig enables (e.g. TP-Link UB500 ->
# /lib/firmware/rtl_bt).
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
# BT diagnostics for the onboard module: btmon is the
# only way to see HCI-level truth on this chip (no CONFIG_BT_DEBUGFS),
# bluetoothctl/btmgmt drive the adapter without the app stack, and the
# deprecated hciconfig/hcitool give raw-HCI legacy-advertising probes.
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
# bluez-alsa: `bluealsad -p a2dp-source` exposes a connected A2DP headset as
# the ALSA PCM `bluealsa:DEV=MAC,PROFILE=a2dp`, which sendspin opens directly
# (no C changes). SBC only — AAC (fdk-aac) is gated on legal review. Selects
# alsa-lib, libglib2, and sbc; peers with BR2_PACKAGE_BLUEZ5_UTILS above.
BR2_PACKAGE_BLUEZ_ALSA=y

# ---- Custom: container engine ----
# podman, driven per operation by Vagus through its CLI. The vagus-* recipes
# are synced from shared/package/ by `make sync`; the kernel side is
# shared/linux-containers.config. cgroup v2 is mounted by erlinit.config.
BR2_PACKAGE_VAGUS_CRUN=y
BR2_PACKAGE_VAGUS_NETAVARK=y
BR2_PACKAGE_VAGUS_PODMAN=y
# Buildroot's 2.1.8. At the size cap it renames a fresh file over the log,
# the same rotation as the 2.2.1 Vagus's log follower was tested against.
BR2_PACKAGE_CONMON=y
# The init process podman runs for --init.
BR2_PACKAGE_CATATONIT=y
# policy.json, and registries.conf with docker.io as the only unqualified
# search registry, as Docker resolved short names.
BR2_PACKAGE_CONTAINERS_IMAGE_CONFIG=y
# netavark's firewall driver, and Vagus programs its own NAT table with nft.
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_NFTABLES_JSON=y
# This BusyBox has no swapon, mkswap, nsenter, mountpoint or pivot_root,
# and Vagus's swapon, mkswap and mount calls were proven against util-linux.
# nsenter is how to look into a container's namespaces from the board's
# shell.
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
BR2_PACKAGE_UTIL_LINUX_PIVOT_ROOT=y
BR2_PACKAGE_UTIL_LINUX_NSENTER=y
# podman's state database compiles in the sqlite that go-sqlite3 vendors
# (see vagus-podman.mk); the system libsqlite3 is only here because nfs-utils
# selects it.

# ---- Hardware-debug host services ----
# Kernel side is base/linux-hwdebug.config. knfsd serves nfsroot to targets
# and needs rpc.nfsd/rpc.mountd/exportfs (plus rpcbind, which RPC_NFSD
# selects) on the host, not in a container. Nothing starts them: with
# BR2_INIT_NONE no init script is installed, so they run only when launched
# explicitly.
# The usbip userland is NOT here: Buildroot's usbip package depends on udev,
# which Nerves does not ship, so `usbip bind`/usbipd run from a privileged
# container against the host's usbip-host module.
BR2_PACKAGE_NFS_UTILS=y
BR2_PACKAGE_NFS_UTILS_RPC_NFSD=y
