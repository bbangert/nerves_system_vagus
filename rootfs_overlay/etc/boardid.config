# boardid.config

# The serial a product provisions when the image is written (empty unless
# NERVES_SERIAL_NUMBER was set) overrides the hardware serial.
-b uboot_env -u nerves_serial_number
-b uboot_env -u serial_number

# The EEPROM serial U-Boot publishes in the device tree is the default. It is
# present even when the U-Boot environment block is blank (first boot or
# corrupted state). The kernel's property carries a trailing NUL, which
# boardid's string handling stops at.
-b device_tree

# The same serial as saved in the U-Boot environment.
# Quoted: an unquoted "#" starts a comment in this file.
-b uboot_env -u "serial#"

# Use the SoC serial number reported in /proc/cpuinfo (Rockchip vendor
# kernels expose the eFUSE CPU ID here).
-b cpuinfo

# Fall back to the MAC address of the first network interface.
-b macaddr
