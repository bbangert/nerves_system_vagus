# U-Boot default environment for the Home Assistant Green, compiled into
# u-boot.itb and also the initial content of the state block
# (uboot-env.bin). Design and rules: uboot/README.md "Boot script".
# Only whole lines starting with '#' are comments: a '#' line inside a
# continued value would end up in the script.

bootcmd=run nerves_main; run nerves_fail

# Each step is its own `run` so a failing step cannot skip the next one.
# Without this boot's command line nothing boots (fail closed), but the
# breadcrumbs still record why.
nerves_main=\
    run nerves_led_on; \
    run nerves_pick_disk; \
    run nerves_load_state; \
    run nerves_init; \
    run nerves_save; \
    if run nerves_setargs; then \
        run nerves_crumbs; \
        if run nerves_load; then \
            run nerves_wdt_start; \
            run nerves_go; \
        fi; \
    else \
        run nerves_crumbs; \
    fi

# The boot disk is the one this U-Boot came from. A 2026.04 SPL names it in
# the control FDT; only the two exact controller paths count, anything else
# falls to the probe rather than to a guess. The NOR's older SPL names
# nothing, so the probe restates its rule: the SD card iff it reads and has
# FDT magic (d0 0d fe ed, here read little-endian) at LBA 0x4000, which
# cannot tell a FIT the SPL rejected from one it loaded. Nothing is imported
# yet, so every operand is compiled in or U-Boot's. `fdt get` leaves its
# variable alone when the property is missing and deletes it when empty.
nerves_pick_disk=\
    setenv nerves_disk 0; \
    setenv nerves_disk_by probe; \
    setenv nerves_sd_fit absent; \
    setenv nerves_spl_boot_device absent; \
    if fdt addr ${fdtcontroladdr}; then \
        fdt get value nerves_spl_boot_device /chosen u-boot,spl-boot-device; \
        test -n "${nerves_spl_boot_device}" || setenv nerves_spl_boot_device empty; \
    fi; \
    mw.l ${nerves_scratch_addr} 0 1; \
    if mmc dev 1 && mmc read ${nerves_scratch_addr} 0x4000 1 && itest.l *${nerves_scratch_addr} == 0xedfe0dd0; then \
        setenv nerves_sd_fit present; \
    fi; \
    if test "${nerves_spl_boot_device}" = /mmc@fe310000; then \
        setenv nerves_disk_by spl; \
    elif test "${nerves_spl_boot_device}" = /mmc@fe2b0000 && mmc dev 1; then \
        setenv nerves_disk 1; \
        setenv nerves_disk_by spl; \
    elif test "${nerves_sd_fit}" = present; then \
        setenv nerves_disk 1; \
    fi

# The block is a full export, and an import that stops at a bad entry (an
# empty key) keeps everything before it. So the variables the script relies
# on (nerves_owned and this boot's own values) are copied to RAM first and
# put back afterwards, and the block counts only if they then match that
# copy exactly. A block that declares .flags or .callbacks does not count.
# One that bound variables and then deleted the declaration through a
# rebound callback leaves the bindings behind, so the table is first rebuilt
# from its own binary export (text does not escape newlines in names) on top
# of the compiled-in one: rebuilt entries carry
# only U-Boot's static bindings, none on a variable nerves_init writes, and
# every compiled-in variable exists, so nerves_init (compiled-in variables
# only) just overwrites and cannot fail, not even once the block has filled
# the 521-entry table. Otherwise the whole environment is reset to the
# compiled-in one. From the import on, any variable may be the block's and
# only this already-parsed text is safe, so its addresses are literals (the
# state buffer's, then 64 KiB each).
nerves_load_state=\
    setenv nerves_state none; \
    env export -t -s 0x10000 0x121a0000 nerves_disk nerves_state ver fdtcontroladdr serial# ethaddr ${nerves_owned}; \
    mw.b ${nerves_state_addr} 0 0x20000; \
    if mmc dev ${nerves_disk} && mmc read ${nerves_state_addr} 0x8000 0x100 && env import -c ${nerves_state_addr} 0x20000; then \
        if env exists .flags || env exists .callbacks; then \
            env default -f -a; \
            env import -t 0x121a0000; \
        elif env export -c -s 0x20000 0x12180000 && env default -f -a && env import -c 0x12180000 0x20000; then \
            env delete -f ethaddr serial#; \
            env import -t 0x121a0000; \
            if env export -t -s 0x10000 0x121e0000 nerves_disk nerves_state ver fdtcontroladdr serial# ethaddr ${nerves_owned} && cmp.l 0x121a0000 0x121e0000 0x4000; then \
                setenv nerves_state ok; \
            else \
                env default -f -a; \
                env import -t 0x121a0000; \
            fi; \
        else \
            env default -f -a; \
            env import -t 0x121a0000; \
        fi; \
    else \
        env default -f -a; \
        env import -t 0x121a0000; \
    fi

# Also carries this boot's disk choice, which is made before the import and
# so is not compiled in.
nerves_owned=\
    nerves_disk_by nerves_sd_fit nerves_spl_boot_device \
    bootcmd nerves_main nerves_pick_disk nerves_load_state nerves_owned \
    nerves_init nerves_revert nerves_save nerves_setargs nerves_crumbs \
    nerves_crumbs_sd nerves_crumb nerves_load nerves_wdt_start nerves_fail \
    nerves_led_on nerves_led_off nerves_go nerves_reset nerves_fail_pause \
    nerves_scratch_addr nerves_state_addr nerves_crumb_addr \
    nerves_crc_addr nerves_crc2_addr nerves_ramoops_addr nerves_ramoops_size \
    nerves_ramoops_dmesg nerves_ramoops_console \
    nerves_wdt_cr nerves_wdt_torr nerves_wdt_crr \
    nerves_save_needed nerves_slot nerves_part \
    nerves_uboot_version nerves_args_rest bootargs filesize \
    nerves_crumb_src nerves_crumb_size nerves_crumb_file \
    kernel_addr_r fdt_addr_r

# The Nerves rule: the first boot of a slot marks it booted; a slot still
# unvalidated when it boots again is reverted.
nerves_init=\
    setenv nerves_save_needed 0; \
    if test "${nerves_fw_booted}" = 1; then \
        if test "${nerves_fw_validated}" = 0; then \
            run nerves_revert; \
            setenv nerves_fw_validated 1; \
            setenv nerves_save_needed 1; \
        fi; \
    else \
        setenv nerves_fw_booted 1; \
        if test "${nerves_fw_autovalidate}" = 1; then \
            setenv nerves_fw_validated 1; \
        fi; \
        setenv nerves_save_needed 1; \
    fi; \
    if test "${nerves_fw_active}" = b; then \
        setenv nerves_slot b; \
        setenv nerves_part 4; \
    else \
        setenv nerves_slot a; \
        setenv nerves_part 3; \
    fi

nerves_revert=\
    if test "${nerves_fw_active}" = b; then \
        echo "Reverting to firmware slot A"; \
        setenv nerves_fw_active a; \
    else \
        echo "Reverting to firmware slot B"; \
        setenv nerves_fw_active b; \
    fi

# The only raw write U-Boot makes, and only back to the disk whose state
# block passed its CRC in this boot: a disk without our block (a stock eMMC)
# is never written.
nerves_save=\
    if test "${nerves_save_needed}" = 1 && test "${nerves_state}" = ok; then \
        env export -c -s 0x20000 ${nerves_state_addr} && mmc dev ${nerves_disk} && mmc write ${nerves_state_addr} 0x8000 0x100; \
    fi

# U-Boot and Linux number the MMC devices alike (aliases mmc0 = eMMC,
# mmc1 = SD). The eMMC booted on the SPL's word with uboot.sd_fit=present
# is where the probe would have picked the SD; the cmdline is the only
# record, as breadcrumbs are SD-only.
# The version string has spaces and parentheses. Fails, and so stops the
# boot, unless bootargs was set (it fails, for one, past CONFIG_SYS_MAXARGS
# words of cmdline) and starts with the root nerves_init chose.
nerves_setargs=\
    setexpr nerves_uboot_version gsub "[ ()]" "_" "${ver}" || setenv nerves_uboot_version unknown; \
    test -n "${nerves_uboot_version}" || setenv nerves_uboot_version unknown; \
    setenv bootargs root=/dev/mmcblk${nerves_disk}p${nerves_part} rootfstype=squashfs rootwait console=ttyS2,1500000n8 console=tty0 uboot.boot_disk=mmcblk${nerves_disk} uboot.boot_disk_by=${nerves_disk_by} uboot.sd_fit=${nerves_sd_fit} uboot.version=${nerves_uboot_version} ${cmdline} && \
    setexpr nerves_args_rest sub "^root=/dev/mmcblk${nerves_disk}p${nerves_part} " "" "${bootargs}" && \
    test "${nerves_args_rest}" != "${bootargs}"

# Breadcrumbs go to the SD card's FAT only; `mmc 1:2` is literal so no
# variable can aim them at the eMMC.
nerves_crumbs=\
    if test "${nerves_disk}" = 1; then \
        run nerves_crumbs_sd; \
    fi

# A crumb is written only once all three of its parameters are this boot's.
# Ramoops is dumped only if a kernel left its zone signature ("DBGC") in RAM.
nerves_crumbs_sd=\
    if env export -t ${nerves_crumb_addr} nerves_disk nerves_state nerves_slot nerves_save_needed nerves_fw_active nerves_fw_validated nerves_fw_booted nerves_spl_boot_device nerves_disk_by nerves_sd_fit serial# ethaddr ver bootargs && setexpr nerves_crumb_size ${filesize} - 1 && setenv nerves_crumb_src ${nerves_crumb_addr} && setenv nerves_crumb_file uboot-vars.txt; then \
        run nerves_crumb; \
    fi; \
    if fdt addr ${fdtcontroladdr} && fdt header get nerves_crumb_size totalsize && setenv nerves_crumb_src ${fdtcontroladdr} && setenv nerves_crumb_file uboot-fdt.dtb; then \
        run nerves_crumb; \
    fi; \
    if itest.l *${nerves_ramoops_dmesg} == 0x43474244 || itest.l *${nerves_ramoops_console} == 0x43474244; then \
        setenv nerves_crumb_src ${nerves_ramoops_addr} && setenv nerves_crumb_size ${nerves_ramoops_size} && setenv nerves_crumb_file ramoops.bin && run nerves_crumb; \
    fi

# Writes the file only if it differs from the card's copy, so steady-state
# boots and reset loops write nothing.
nerves_crumb=\
    mw.l ${nerves_crc_addr} 0 1; \
    mw.l ${nerves_crc2_addr} 0 1; \
    crc32 ${nerves_crumb_src} ${nerves_crumb_size} ${nerves_crc_addr}; \
    if fatload mmc 1:2 ${nerves_scratch_addr} ${nerves_crumb_file} ${nerves_crumb_size} && itest ${filesize} == ${nerves_crumb_size} && crc32 ${nerves_scratch_addr} ${filesize} ${nerves_crc2_addr} && itest.l *${nerves_crc_addr} == *${nerves_crc2_addr}; then \
        echo "${nerves_crumb_file} unchanged"; \
    else \
        fatwrite mmc 1:2 ${nerves_crumb_src} ${nerves_crumb_file} ${nerves_crumb_size}; \
    fi

nerves_load=\
    load mmc ${nerves_disk}:2 ${kernel_addr_r} Image.${nerves_slot} && load mmc ${nerves_disk}:2 ${fdt_addr_r} rk3566-ha-green.${nerves_slot}.dtb

# Off unless the state block sets nerves_watchdog=1. U-Boot's own driver
# cannot probe here (the RK3568 clock driver has no enable op), and once on
# the dw-wdt stops only on reset, so Linux must be proven to take it over
# first. Same writes as designware_wdt_start(): TOP 15 = 2^31 ticks of
# 24 MHz, about 89 s, reset on first expiry.
nerves_wdt_start=\
    if test "${nerves_watchdog}" = 1; then \
        mw.l ${nerves_wdt_torr} 0xff; \
        mw.l ${nerves_wdt_cr} 0x1; \
        mw.l ${nerves_wdt_crr} 0x76; \
    fi

# Nobody can see a prompt: turn the user LED off, pause so a persistent
# failure does not hammer the disks, and start over.
nerves_fail=\
    echo "Boot failed, resetting"; \
    run nerves_led_off; \
    sleep ${nerves_fail_pause}; \
    run nerves_reset

nerves_led_on=led user on
nerves_led_off=led user off
nerves_go=booti ${kernel_addr_r} - ${fdt_addr_r}
nerves_reset=reset
nerves_fail_pause=10
# Compiled in, like every variable the script sets after nerves_load_state,
# so that setting one only overwrites and cannot fail on a full table.
nerves_save_needed=0
nerves_slot=a
nerves_part=3
nerves_uboot_version=unknown
nerves_args_rest=unset
# U-Boot cannot hold an empty value. nerves_setargs refuses this one.
bootargs=unset
filesize=0
nerves_crumb_src=0
nerves_crumb_size=0
nerves_crumb_file=unset

# Kernel and dtb addresses from include/configs/rk3568_common.h. Scratch
# areas stay clear of the ramoops region (0x110000-0x1fffff, reserved by the
# kernel DTS) and of everything loaded. nerves_load_state also uses
# 0x12180000-0x121affff and 0x121e0000-0x121effff, as literals.
kernel_addr_r=0x02000000
fdt_addr_r=0x12000000
nerves_scratch_addr=0x00c00000
nerves_state_addr=0x12180000
nerves_crumb_addr=0x121b0000
nerves_crc_addr=0x121c0000
nerves_crc2_addr=0x121c0010
nerves_ramoops_addr=0x00110000
nerves_ramoops_size=0xf0000
nerves_ramoops_dmesg=0x00110000
nerves_ramoops_console=0x00130000
nerves_wdt_cr=0xfe600000
nerves_wdt_torr=0xfe600004
nerves_wdt_crr=0xfe60000c

# Nerves state: what a missing or corrupt state block boots with (slot A,
# validated, never saved) and the initial uboot-env.bin values.
nerves_fw_active=a
# nerves_runtime validates once the application is up.
nerves_fw_autovalidate=0
nerves_fw_validated=1
nerves_fw_booted=0
nerves_watchdog=0
# Extra kernel arguments, settable with fw_setenv.
cmdline=
