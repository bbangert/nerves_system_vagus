config BR2_PACKAGE_VAGUS_CRUN
	bool "vagus-crun"
	depends on BR2_USE_MMU # fork()
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 # C11/stdatomic.h
	depends on BR2_TOOLCHAIN_HAS_SYNC_4 # json-c
	depends on BR2_PACKAGE_LIBSECCOMP_ARCH_SUPPORTS # libseccomp
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_17 # libseccomp
	depends on !BR2_PACKAGE_CRUN # both install /usr/bin/crun
	select BR2_PACKAGE_ARGP_STANDALONE if !BR2_TOOLCHAIN_USES_GLIBC
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_LIBCAP
	select BR2_PACKAGE_LIBSECCOMP
	help
	  crun 1.30.1 (json-c based, replaces YAJL since 1.28), built
	  from the release tarball. Vagus-owned because the stock
	  Buildroot crun package is 1.24 and cannot be redefined from
	  an external tree.

	  https://github.com/containers/crun

comment "vagus-crun needs a glibc or musl toolchain, gcc >= 4.9, headers >= 3.17"
	depends on BR2_USE_MMU
	depends on BR2_PACKAGE_LIBSECCOMP_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_USES_UCLIBC || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 || \
		!BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_17
